# ==========================================
# CẤU HÌNH MẪU SHOPEE RETURN MANAGER (.env.example)
# Sao chép file này thành .env và điền các thông số cần thiết
# ==========================================

# Gemini AI (Viết & tối ưu nội dung sản phẩm)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Notion Database & Page
NOTION_TOKEN=
NOTION_DATABASE_ID=
NOTION_PAGE_ID=

# Google Sheet (Đối chiếu đơn hàng)
GOOGLE_SHEET_URL=

# Telegram Bot (Thông báo hoàn huỷ)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Studio Settings
STUDIO_DRIVE_LOCAL_FOLDER=G:\My Drive\Hình ảnh Shopee\Sản phẩm thay thế
STUDIO_CHATGPT_PORT=9222
